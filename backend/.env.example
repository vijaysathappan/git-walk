# Copy this file to backend/.env. Never commit the real values.
APP_ENV=development
APP_URL=https://localhost:3000
API_BASE_URL=http://localhost:8000
OFFICE_ADDIN_URL=https://localhost:3000
DATABASE_URL=sqlite:///./queue_board.db
CORS_ORIGINS=https://localhost:3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your-account@gmail.com

AUTH_SECRET=replace-with-a-long-random-value
AUTH_REQUIRED=true
DEV_SHOW_OTP=false
SESSION_HOURS=24
OTP_MINUTES=10
OTP_REQUEST_COOLDOWN_SECONDS=60
OTP_REQUESTS_PER_HOUR=5

# Bounded workbook processing
MAX_UPLOAD_BYTES=26214400
MAX_XLSX_ENTRIES=2500
MAX_XLSX_UNCOMPRESSED_BYTES=262144000
MAX_WORKBOOK_SHEETS=100
MAX_WORKBOOK_ROWS=250000
MAX_WORKBOOK_COLUMNS=1000
UPLOAD_PROCESSING_TIMEOUT_SECONDS=60
TEMP_FILE_MAX_AGE_HOURS=24
LOG_LEVEL=INFO

# Optional AI gateway
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_MODELS=openai/gpt-4.1-mini
